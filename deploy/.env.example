# Copy to .env and edit. Keep this file private (chmod 600): it can hold the
# setup token.

# The release to run. Pin it, and change it when you update.
CLAVIS_VERSION=0.3.4

# The address people use to reach Clavis, with https:// when TLS is on.
CLAVIS_SERVER_BASE_URL=https://192.168.1.20

# self-signed (an IP address or a LAN name), acme (a public domain), or off
# (plain HTTP, behind your own reverse proxy).
CLAVIS_TLS=self-signed

# Host ports. Use 8080 and 8443 if something else owns 80 and 443.
CLAVIS_HTTP_PORT=80
CLAVIS_HTTPS_PORT=443

# Optional: claim the server with your own token and email on first start.
# CLAVIS_SETUP_TOKEN=at-least-24-random-characters
# CLAVIS_SETUP_OWNER_EMAIL=you@example.com
