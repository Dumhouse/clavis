# GoReleaser builds the binary per platform and places it under $TARGETPLATFORM
# in this build context (dockers_v2).
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/clavis /usr/local/bin/clavis
USER nonroot:nonroot
EXPOSE 8080
ENV CLAVIS_SERVER_ADDR=:8080 \
    CLAVIS_DATA_DIR=/data \
    CLAVIS_LOG_FORMAT=json
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/clavis"]
CMD ["server"]
