# Maintainer: Dumhouse <noreply@users.noreply.github.com>
# Arch Linux package that installs the official release binary.
# Update pkgver and the checksums with: scripts/update-packages.sh <version>
# The completions below ship from the first release that includes them (after
# 0.3.3); drop the three completion lines to package an earlier release.
pkgname=clavis-bin
pkgver=0.3.3
pkgrel=1
pkgdesc='Open-source secrets management for humans, machines, and AI agents (CLI and server)'
arch=('x86_64' 'aarch64')
url='https://dumhouse.github.io/clavis/'
license=('Apache-2.0')
provides=('clavis')
conflicts=('clavis')
source_x86_64=("clavis-${pkgver}-amd64.tar.gz::https://github.com/Dumhouse/clavis/releases/download/v${pkgver}/clavis_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("clavis-${pkgver}-arm64.tar.gz::https://github.com/Dumhouse/clavis/releases/download/v${pkgver}/clavis_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 clavis "${pkgdir}/usr/bin/clavis"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 completions/clavis.bash "${pkgdir}/usr/share/bash-completion/completions/clavis"
  install -Dm644 completions/_clavis "${pkgdir}/usr/share/zsh/site-functions/_clavis"
  install -Dm644 completions/clavis.fish "${pkgdir}/usr/share/fish/vendor_completions.d/clavis.fish"
}
